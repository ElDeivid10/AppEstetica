{
  "expo": {
    "name": "Yoss Beauty Salon",
    "slug": "yoss-beauty-salon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yossbeautysalon",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoss.beautysalon",
      "infoPlist": {
        "NSCameraUsageDescription": "Yoss Beauty Salon requiere acceso a la cámara para tomar tu foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Yoss Beauty Salon requiere acceso a tus fotos para seleccionar tu foto de perfil."
      }
    },
    "android": {
      "package": "com.yoss.beautysalon",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación requiere acceso a tu galería para elegir tu foto de perfil.",
          "cameraPermission": "La aplicación requiere acceso a tu cámara para tomar tu foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
